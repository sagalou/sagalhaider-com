DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sagalhaider.com

# Set DB_ENGINE=postgres in production, leave unset for local SQLite
DB_ENGINE=
DB_NAME=sagalhaider
DB_USER=sagalhaider
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (NoSQL rate limiting store). Set REDIS_DISABLED=1 to fall back to
# local memory when no Redis server is available (e.g. quick local dev).
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DISABLED=1

# SMTP (Gmail) for confirmation + reminder emails.
# Use console backend locally to just print emails to stdout.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=contact@sagalhaider.com

# Anthropic API key for the chatbot LLM fallback
ANTHROPIC_API_KEY=
